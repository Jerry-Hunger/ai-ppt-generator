# 应用
DEBUG=true

# 数据库与缓存（docker compose 端口段 39xxx）
DATABASE_URL=postgresql+asyncpg://aippt:aippt@localhost:39432/aippt
REDIS_URL=redis://localhost:39379/0

# JWT 鉴权（生产环境用 openssl rand -hex 32 生成，长度需 ≥32 字节以消除 pyjwt 警告）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# LLM（OpenAI 兼容接口，默认 DeepSeek）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
